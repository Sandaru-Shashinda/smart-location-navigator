EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Used by the native Google Maps SDK (iOS + Android). Typically restricted
# per-platform in Google Cloud Console to "Maps SDK for Android" / "Maps SDK
# for iOS" with an app restriction (bundle ID / package name + SHA-1).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Routing backend used by src/lib/directions.ts. Defaults to "osrm" when unset.
#   osrm   — public OSRM demo server. No key, no billing, no signup. Static
#            (non-traffic) ETAs, car profile only, no toll avoidance.
#   google — Directions API. Live traffic-aware ETAs and toll avoidance, but
#            the Cloud project must have a billing account attached or every
#            call returns REQUEST_DENIED — even inside the free quota.
EXPO_PUBLIC_DIRECTIONS_PROVIDER=osrm

# Only used when EXPO_PUBLIC_DIRECTIONS_PROVIDER=google. Directions is a plain
# HTTP fetch from JS, so it must be a SEPARATE key with "Directions API"
# enabled and NO app restriction (Android/iOS app-restricted keys reject raw
# HTTP requests). Falls back to EXPO_PUBLIC_GOOGLE_MAPS_API_KEY above if unset.
EXPO_PUBLIC_GOOGLE_DIRECTIONS_API_KEY=your-google-directions-api-key-here
